# SECURITY FIX: real values must live only in .env.local (gitignored), never in source.
# Copy this file to .env.local and fill in the real values.

# MongoDB connection string (required)
MONGODB_URI=

# better-auth (required) — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Gemini AI threat analysis (optional — falls back gracefully if missing)
GEMINI_API_KEY=

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin allowlist — comma-separated emails. Required for /admin access.
# If empty/missing, admin routes deny ALL access (fail-closed).
ADMIN_EMAILS=

# Transactional email (Resend)
RESEND_API_KEY=

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
